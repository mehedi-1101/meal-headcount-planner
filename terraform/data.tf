# Look up the latest Amazon Linux 2023 AMI at apply time.
# This avoids hardcoding an AMI ID that changes per region and goes stale over time.
data "aws_ami" "amazon_linux_2023" {
  most_recent = true
  owners      = ["amazon"]

  filter {
    name   = "name"
    values = ["al2023-ami-*-x86_64"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}
