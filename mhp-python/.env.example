# Copy this to .env and fill in your values
# Never commit .env to git

# JWT — generate a strong random string: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# AWS region — boto3 uses credentials from AWS CLI (~/.aws/credentials) automatically
# Only needed if you want to override the CLI default
AWS_REGION=ap-south-1

# DynamoDB table name
DYNAMODB_TABLE=mhp
